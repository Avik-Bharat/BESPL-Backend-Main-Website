# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database --------------------------------------------------------------
# MongoDB Atlas connection string. URL-encode any special characters in the
# password (@ -> %40, # -> %23, / -> %2F).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bespl?retryWrites=true&w=majority

# --- CORS ------------------------------------------------------------------
# Comma-separated, no trailing slash. Required in production.
ALLOWED_ORIGINS=https://bharatengineeringservices.com,https://www.bharatengineeringservices.com,http://localhost:3000

# Number of reverse proxies in front of the app (Render/Railway/Nginx = 1).
# Getting this wrong lets clients spoof their IP past the rate limiter.
TRUST_PROXY=1

# --- Abuse protection ------------------------------------------------------
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# --- Email (Gmail app password) --------------------------------------------
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below
# (spaces are fine). Your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bharatengineeringservices.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Must be the authenticated mailbox (or a verified alias of it) or Gmail rewrites it.
MAIL_FROM="Bharat Engineering Services" <info@bharatengineeringservices.com>

# Who gets notified about new leads (comma-separated).
SALES_RECIPIENTS=info@bharatengineeringservices.com,sashi@bharatengineeringservices.com

# Acknowledgement email to the visitor.
AUTO_REPLY_ENABLED=true

# Also email the PDF to brochure requesters, in case the browser blocks the download.
BROCHURE_ATTACH_ENABLED=true

# Folder holding the brochure PDFs (defaults to ./brochures next to package.json).
# BROCHURE_DIR=./brochures
